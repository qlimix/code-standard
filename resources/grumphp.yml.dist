grumphp:
  stop_on_failure: false
  ignore_unstaged_changes: false
  ascii:
    failed: ~
    succeeded: ~
  tasks:
    phpcs:
      standard: phpcs.xml.dist
      # the Qlimix standard excludes */tests/*, so a commit touching only tests would leave phpcs without files
      whitelist_patterns: ['/^src\/(.*)/']
    phpmd:
      ruleset: ['vendor/qlimix/code-standard/src/MessDetection/ruleset.xml']
    phpstan:
      level: 7
      ignore_patterns:
        - "spec"
        - "tests"
        - "app"
        - "config"
        - "public"
        - "bin"
        - "docs"
    psalm:
      config: psalm.xml.dist
      ignore_patterns: []
      no_cache: false
      report: ~
      output_format: null
      threads: 1
      triggered_by: ['php']
      show_info: false
