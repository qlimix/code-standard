{
    "name": "qlimix/code-standard",
    "type": "library",
    "description": "Qlimix code standard",
    "license": "MIT",
    "keywords": [
        "qlimix",
        "code",
        "standard"
    ],
    "authors": [
        {
            "name": "frank",
            "email": "frank@qlimix.net"
        }
    ],
    "require": {
        "php": ">=8.4",
        "php-coveralls/php-coveralls": "^2.4",
        "phpmd/phpmd": "^2.8",
        "phpro/grumphp": "^2.12",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.1",
        "qlimix/codesniffer-standard": "^4.0",
        "psalm/phar": "^6.10"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true
        }
    },
    "bin": ["bin/q-codestandard-defaults"],
    "autoload": {
        "psr-4": {
            "Qlimix\\CodeStandard\\": "src/"
        }
    }
}
