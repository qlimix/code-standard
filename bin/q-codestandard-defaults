#!/usr/bin/env php
<?php declare(strict_types=1);

$autoLoaderPath = getcwd().DIRECTORY_SEPARATOR.'vendor'.DIRECTORY_SEPARATOR.'autoload.php';
if (!file_exists($autoLoaderPath)) {
    fwrite(STDERR, 'Can\'t find composer autoloader'.PHP_EOL);
    exit(1);
}

require $autoLoaderPath;

use Qlimix\CodeStandard\CodeStandardConfig;

function writeConfig(CodeStandardConfig $config): void
{
    if (file_exists($config->getDestinationPath())) {
        echo $config->getName().': '.$config->getDestinationPath().' exists, skipped'.PHP_EOL;
        return;
    }

    if (copy($config->getResourcePath(), $config->getDestinationPath()) === false) {
        throw new RuntimeException('Failed to copy '.$config->getName().' config');
    }

    echo $config->getName().': wrote '.$config->getDestinationPath().PHP_EOL;
}

$path = getcwd().'/vendor/qlimix/code-standard';

// the .dist files are the shared project configs; phpunit.xml, phpcs.xml and psalm.xml stay free for local overrides
$configs = [
    new CodeStandardConfig(
        'GrumPHP',
        $path.'/resources/grumphp.yml.dist',
        getcwd().'/grumphp.yml'
    ),
    new CodeStandardConfig(
        'PHPCS',
        $path.'/resources/phpcs.xml.dist',
        getcwd().'/phpcs.xml.dist'
    ),
    new CodeStandardConfig(
        'PHPUnit',
        $path.'/resources/phpunit.xml.dist',
        getcwd().'/phpunit.xml.dist'
    ),
    new CodeStandardConfig(
        'Psalm',
        $path.'/resources/psalm.xml.dist',
        getcwd().'/psalm.xml.dist'
    ),
];

foreach ($configs as $config) {
    writeConfig($config);
}
